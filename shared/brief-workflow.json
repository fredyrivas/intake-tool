  "responseContracts": {
    "definitions": {
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "documentId",
          "page",
          "excerpt"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "document",
              "note",
              "interpretation"
            ]
          },
          "documentId": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "excerpt": {
            "type": "string"
          },
          "webUrl": {
            "type": "string"
          }
        }
      },
      "documentClassifications": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documentId",
            "fieldId",
            "page",
            "excerpt"
          ],
          "properties": {
            "documentId": {
              "type": "string"
            },
            "fieldId": {
              "$ref": "#/$defs/documentRole"
            },
            "page": {
              "type": "integer"
            },
            "excerpt": {
              "type": "string"
            }
          }
        }
      },
      "facts": {
        "type": "array",
        "maxItems": 150,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic",
            "value",
            "source"
          ],
          "properties": {
            "topic": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "proposals",
        "questions",
        "warnings"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "proposals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fieldId",
              "values",
              "source"
            ],
            "properties": {
              "fieldId": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fieldId",
              "prompt",
              "context",
              "options"
            ],
            "properties": {
              "fieldId": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "context": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "facts",
        "documentClassifications",
        "warnings"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "facts": {
          "$ref": "#/$defs/facts"
        },
        "documentClassifications": {
          "$ref": "#/$defs/documentClassifications"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
